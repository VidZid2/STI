# ================================================================
# Supabase Configuration
# ================================================================
# Get these from: Supabase Dashboard > Settings > API
# ================================================================
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ================================================================
# iLovePDF API Keys - Multi-Account Rotation System
# ================================================================
# 5 Accounts × 250 files = 1,250 files/month FREE!
# Auto-rotation: When one account runs out, switches to the next
# ================================================================
VITE_ILOVEPDF_PUBLIC_KEY_1=YOUR_ILOVEPDF_PUBLIC_KEY_1_HERE
VITE_ILOVEPDF_SECRET_KEY_1=YOUR_ILOVEPDF_SECRET_KEY_1_HERE

VITE_ILOVEPDF_PUBLIC_KEY_2=YOUR_ILOVEPDF_PUBLIC_KEY_2_HERE
VITE_ILOVEPDF_SECRET_KEY_2=YOUR_ILOVEPDF_SECRET_KEY_2_HERE

VITE_ILOVEPDF_PUBLIC_KEY_3=YOUR_ILOVEPDF_PUBLIC_KEY_3_HERE
VITE_ILOVEPDF_SECRET_KEY_3=YOUR_ILOVEPDF_SECRET_KEY_3_HERE

VITE_ILOVEPDF_PUBLIC_KEY_4=YOUR_ILOVEPDF_PUBLIC_KEY_4_HERE
VITE_ILOVEPDF_SECRET_KEY_4=YOUR_ILOVEPDF_SECRET_KEY_4_HERE

VITE_ILOVEPDF_PUBLIC_KEY_5=YOUR_ILOVEPDF_PUBLIC_KEY_5_HERE
VITE_ILOVEPDF_SECRET_KEY_5=YOUR_ILOVEPDF_SECRET_KEY_5_HERE

# ================================================================
# CloudConvert API (Secondary Fallback)
# ================================================================
# Get your free API key at: https://cloudconvert.com/dashboard/api/v2/keys
# Free tier: 25 conversions per day
# ================================================================
VITE_CLOUDCONVERT_API_KEY=YOUR_CLOUDCONVERT_API_KEY_HERE

# ================================================================
# Adobe PDF Services API Keys (5 accounts = 2,500 PDF→Word/month)
# ================================================================
VITE_ADOBE_CLIENT_ID_1=YOUR_ADOBE_CLIENT_ID_1_HERE
VITE_ADOBE_CLIENT_SECRET_1=YOUR_ADOBE_CLIENT_SECRET_1_HERE

VITE_ADOBE_CLIENT_ID_2=YOUR_ADOBE_CLIENT_ID_2_HERE
